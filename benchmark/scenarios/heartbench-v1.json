          "depends": [
            "a"
          ]
        }
      ],
      "steps": [
        {
          "target": "a",
          "operation": "update",
          "expect": "accept",
          "expected_state": {
            "revision": 1,
            "inactive": [
              "b"
            ],
            "versions": {
              "a": 2,
              "b": 1
            },
            "withdrawn": [],
            "provenance_events": 1
