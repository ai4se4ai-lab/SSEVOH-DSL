ACCOUNT="${ACCOUNT:-def-mbabaei_gpu}"
MAIL_TYPE="NONE"
MAX_REQUEUES=3
REQUEUE_SIGNAL_SECS=120
MODULES="StdEnv/2023 python/3.12.4"
EXTRA_WHEELS=""
SRC_DIRS="src"
CODE_HASH_DIRS="src benchmark formal experiments integrations hpc"
WORK="${WORK:-${SCRATCH:-$HOME/scratch}/ssevoh}"
RESULTS_DEST=""
GPU_MONITOR_SECS=60
CLUSTER="${CLUSTER:-local}"
OLLAMA_BIN="${OLLAMA_BIN:-/scratch/mbabaei/heartness-work/ollama/bin/ollama}"
SEED_MODEL_CACHE="${SEED_MODEL_CACHE:-/scratch/mbabaei/heartness-work/ollama-models}"
OLLAMA_MODELS="${WORK}/models"
ALLOW_MODEL_DOWNLOAD="${ALLOW_MODEL_DOWNLOAD:-0}"

TZ="UTC"
