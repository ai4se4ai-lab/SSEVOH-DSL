{
  "project": "ssevoh-harness2",
  "study": "harness2-controlled-v1",
  "require_gpu": true,
  "vars": {
    "MODELS": "qwen2.5-coder:7b phi4:14b gpt-oss:20b devstral:24b qwen3-coder:30b",
    "REPEATS": "5",
    "QUAL_FLAG": ""
  },
  "smoke": {
    "vars": {
      "MODELS": "qwen2.5-coder:7b phi4:14b",
      "REPEATS": "1",
      "QUAL_FLAG": "--qualification"
    },
    "time": "00:45:00",
    "matrix_limit": 2,
    "array_throttle": 1
  },
  "stages": [
    {
      "name": "setup",
      "description": "setup",
      "depends": [],
      "cpu_only": false,
      "resources": {
        "gpus": "h100:1",
        "cpus": 4,
        "mem": "32G",
        "time": "01:00:00",
        "requeue": true
      },
      "steps": [
        {
          "name": "gpu",
          "builtin": "check_gpu",
          "critical": true
        },
        {
          "name": "harness2-runtime",
          "cmd": "python experiments/scripts/harness2_preflight.py --output \"{RESULTS}/setup/harness2.json\"",
          "produces": [
            "setup/harness2.json"
          ],
          "critical": true
        },
        {
          "name": "pins",
          "cmd": "python experiments/scripts/runtime.py freeze --models {MODELS} --output \"{RESULTS}/setup/models.lock.json\"",
          "produces": [
            "setup/models.lock.json"
          ],
          "critical": true
        }
      ]
    },
    {
      "name": "deterministic",
      "description": "RQ6\u2013RQ10: actual C0\u2013C3 file/execution comparisons, lifecycle cases and eight isolated ablations",
      "depends": [
        {
          "stage": "setup",
          "type": "afterok"
        }
      ],
      "cpu_only": true,
      "resources": {
        "cpus": 2,
        "mem": "4G",
        "time": "00:20:00",
        "requeue": true
      },
      "sbatch_extra": [
        "--account=def-mbabaei_cpu"
      ],
      "steps": [
        {
          "name": "conditions",
          "cmd": "python experiments/scripts/harness2_deterministic.py --output \"{RESULTS}/deterministic/records.jsonl\" --repeats {REPEATS}",
          "needs": [
            "setup/harness2.json"
          ],
          "produces": [
            "deterministic/records.jsonl"
          ],
          "critical": true
        }
      ]
    },
    {
      "name": "llm",
      "description": "C4: unchanged Harness\u00b2 recursion with data-only model edits, bounded model executor, two ledger tasks and frozen controls",
      "depends": [
        {
          "stage": "setup",
          "type": "afterok"
        }
      ],
      "cpu_only": false,
      "resources": {
        "gpus": "h100:1",
        "cpus": 4,
        "mem": "32G",
        "time": "02:00:00",
        "requeue": true
      },
      "steps": [
        {
          "name": "generate",
          "cmd": "python experiments/scripts/harness2_models.py --model {model} --output \"{RESULTS}/llm/{CELL}.jsonl\" --lock \"{RESULTS}/setup/models.lock.json\" --repeats {REPEATS} {QUAL_FLAG}",
          "needs": [
            "setup/models.lock.json",
            "setup/harness2.json"
          ],
          "produces": [
            "llm/{CELL}.jsonl"
          ],
          "progress": {
            "file": "llm/{CELL}.jsonl",
            "expected": "{REPEATS}"
          },
          "critical": true
        }
      ],
      "matrix": {
        "model": [
          "qwen2.5-coder:7b",
          "phi4:14b",
          "gpt-oss:20b",
          "devstral:24b",
          "qwen3-coder:30b"
        ]
      },
      "array_throttle": 1
    },
    {
      "name": "analysis",
      "description": "Descriptive observed outcomes with explicit denominators and scope limits",
      "depends": [
        {
          "stage": "deterministic",
          "type": "afterany"
        },
        {
          "stage": "llm",
          "type": "afterany"
        }
      ],
      "cpu_only": true,
      "resources": {
        "cpus": 2,
        "mem": "4G",
        "time": "00:20:00",
        "requeue": true
      },
      "sbatch_extra": [
        "--account=def-mbabaei_cpu"
      ],
      "steps": [
        {
          "name": "tables",
          "cmd": "python experiments/scripts/harness2_analyze.py --root \"{RESULTS}\" --output \"{RESULTS}/analysis\"",
          "produces": [
            "analysis/summary.json",
            "analysis/summary.csv",
            "analysis/summary.md",
            "analysis/summary.tex",
            "analysis/unsafe-deployments.svg"
          ],
          "critical": true
        },
        {
          "name": "resume-check",
          "cmd": "python experiments/scripts/harness2_resume.py --results \"{RESULTS}\" --repeats {REPEATS}",
          "needs": [
            "deterministic/records.jsonl"
          ],
          "produces": [
            "analysis/resume-check.json"
          ],
          "critical": true
        }
      ]
    },
    {
      "name": "collect",
      "description": "collect",
      "depends": [
        {
          "stage": "analysis",
          "type": "afterany"
        }
      ],
      "cpu_only": true,
      "resources": {
        "cpus": 2,
        "mem": "4G",
        "time": "00:20:00",
        "requeue": true
      },
      "steps": [
        {
          "name": "persist",
          "builtin": "collect",
          "needs": [
            "analysis/summary.json"
          ],
          "critical": true
        }
      ],
      "sbatch_extra": [
        "--account=def-mbabaei_cpu"
      ]
    }
  ],
  "results": {
    "tables": [
      {
        "name": "model_streams",
        "glob": "llm/*.jsonl"
      },
      {
        "name": "controlled_cases",
        "glob": "deterministic/*.jsonl"
      }
    ],
    "summaries": [],
    "copy": [
      "analysis/**",
      "setup/*.json"
    ],
    "archive": [
      "llm",
      "deterministic"
    ]
  }
}
